rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConnected(a, b) {
      return (
        exists(/databases/$(database)/documents/follows/$(a + "_" + b)) &&
        get(/databases/$(database)/documents/follows/$(a + "_" + b)).data.status == "accepted"
      ) || (
        exists(/databases/$(database)/documents/follows/$(b + "_" + a)) &&
        get(/databases/$(database)/documents/follows/$(b + "_" + a)).data.status == "accepted"
      );
    }

    function isRoomHost(roomId) {
      return signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomId))
        && get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId
          == request.auth.uid;
    }

    function isRoomMember(roomId) {
      return signedIn()
        && exists(
          /databases/$(database)/documents/rooms/$(roomId)/participants/$(request.auth.uid)
        );
    }

    function validRoomSubmission(roomId, userId) {
      return request.resource.data.keys().hasOnly([
          "roomId", "userId", "displayName", "profilePhoto",
          "title", "thought", "imageURL", "imageFingerprint", "quote", "quotePosition", "quoteTone",
          "originalityConfirmed", "integrityScore", "integrityFlags", "theme", "score",
          "feedback", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "roomId", "userId", "displayName", "profilePhoto",
          "title", "thought", "imageURL", "imageFingerprint", "quote", "quotePosition", "quoteTone",
          "originalityConfirmed", "integrityScore", "integrityFlags", "theme", "score",
          "feedback", "createdAt", "updatedAt"
        ])
        && request.resource.data.roomId == roomId
        && request.resource.data.userId == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.profilePhoto is string
        && request.resource.data.profilePhoto.size() <= 180000
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 100
        && request.resource.data.thought is string
        && request.resource.data.thought.size() >= 80
        && request.resource.data.thought.size() <= 3000
        && request.resource.data.imageURL is string
        && request.resource.data.imageURL.size() <= 500000
        && request.resource.data.imageURL.matches(
          "^data:image/(jpeg|png|webp);base64,.*"
        )
        && request.resource.data.imageFingerprint is string
        && request.resource.data.imageFingerprint.matches("^[a-f0-9]{16}$")
        && request.resource.data.quote is string
        && request.resource.data.quote.size() >= 5
        && request.resource.data.quote.size() <= 180
        && request.resource.data.quotePosition in ["top", "center", "bottom"]
        && request.resource.data.quoteTone in ["light", "dark"]
        && request.resource.data.originalityConfirmed == true
        && request.resource.data.integrityScore is int
        && request.resource.data.integrityScore >= 0
        && request.resource.data.integrityScore <= 100
        && request.resource.data.integrityFlags is list
        && request.resource.data.integrityFlags.size() <= 6
        && request.resource.data.theme is string
        && request.resource.data.theme in [
          "Creative Expression", "Culture & Heritage", "Technology for Good",
          "Life & Wellbeing", "Nature & Sustainability", "Student Innovation",
          "Social Impact"
        ]
        && request.resource.data.score is int
        && request.resource.data.score >= 1
        && request.resource.data.score <= 10
        && request.resource.data.feedback is string
        && request.resource.data.feedback.size() >= 5
        && request.resource.data.feedback.size() <= 260
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function validUsername(userId) {
      return (
        !request.resource.data.keys().hasAny(["username", "usernameLower"])
      ) || (
        request.resource.data.keys().hasAll(["username", "usernameLower"]) &&
        request.resource.data.username is string &&
        request.resource.data.usernameLower is string &&
        request.resource.data.username == request.resource.data.usernameLower &&
        request.resource.data.username.matches("^[a-z0-9_]{3,20}$") &&
        existsAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ) &&
        getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)
        ).data.uid == userId
      );
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasOnly([
          "displayName",
          "email",
          "photoURL",
          "bio",
          "location",
          "website",
          "username",
          "usernameLower",
          "joinedAt",
          "lastSeenAt",
          "updatedAt"
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 50
        && request.resource.data.email == request.auth.token.email
        && (!request.resource.data.keys().hasAny(["bio"])
          || (request.resource.data.bio is string
            && request.resource.data.bio.size() <= 220))
        && (!request.resource.data.keys().hasAny(["photoURL"])
          || (request.resource.data.photoURL is string
            && request.resource.data.photoURL.size() <= 180000))
        && (!request.resource.data.keys().hasAny(["location"])
          || (request.resource.data.location is string
            && request.resource.data.location.size() <= 80))
        && (!request.resource.data.keys().hasAny(["website"])
          || (request.resource.data.website is string
            && request.resource.data.website.size() <= 300
            && (request.resource.data.website == ""
              || request.resource.data.website.matches("^https://.*"))))
        && validUsername(userId);
    }

    function validPostMedia() {
      return (
        !request.resource.data.keys().hasAny(["mediaType", "mediaURL"])
      ) || (
        request.resource.data.keys().hasAll(["mediaType", "mediaURL"])
        && request.resource.data.mediaType in ["image", "video"]
        && request.resource.data.mediaURL is string
        && (
          (
            request.resource.data.mediaType == "image"
            && request.resource.data.mediaURL.size() <= 500000
          )
          || (
            request.resource.data.mediaType == "video"
            && request.resource.data.mediaURL.size() <= 1000
            && request.resource.data.mediaURL.matches("^https://.*")
          )
        )
      );
    }

    function validPostTheme() {
      return !request.resource.data.keys().hasAny(["theme"])
        || (
          request.resource.data.theme is string
          && request.resource.data.theme in [
            "Creative Expression",
            "Culture & Heritage",
            "Technology for Good",
            "Life & Wellbeing",
            "Nature & Sustainability",
            "Student Innovation",
            "Social Impact"
          ]
        );
    }

    function validPostAnalysis() {
      return !request.resource.data.keys().hasAny([
          "meaningfulnessStars", "analysisVersion"
        ])
        || (
          request.resource.data.keys().hasAll([
            "meaningfulnessStars", "analysisVersion"
          ])
          && request.resource.data.meaningfulnessStars is int
          && request.resource.data.meaningfulnessStars >= 0
          && request.resource.data.meaningfulnessStars <= 10
          && request.resource.data.analysisVersion is string
          && request.resource.data.analysisVersion.size() <= 40
        );
    }

    function validPostShape() {
      return request.resource.data.keys().hasOnly([
          "title", "excerpt", "body", "theme", "category",
          "authorId", "authorName", "authorUsername", "authorPhoto",
          "meaningfulnessStars", "analysisVersion", "createdAt",
          "mediaType", "mediaURL"
        ])
        && request.resource.data.keys().hasAll([
          "title", "excerpt", "body", "theme", "category",
          "authorId", "authorName", "meaningfulnessStars",
          "analysisVersion", "createdAt"
        ])
        && request.resource.data.excerpt is string
        && request.resource.data.excerpt.size() >= 15
        && request.resource.data.excerpt.size() <= 260
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.category == request.resource.data.theme
        && request.resource.data.createdAt is timestamp
        && (!request.resource.data.keys().hasAny(["authorUsername"])
          || (request.resource.data.authorUsername is string
            && (request.resource.data.authorUsername == ""
              || request.resource.data.authorUsername.matches("^[a-z0-9_]{3,20}$"))))
        && (!request.resource.data.keys().hasAny(["authorPhoto"])
          || (request.resource.data.authorPhoto is string
            && request.resource.data.authorPhoto.size() <= 180000));
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && validProfile(userId);
      allow delete: if signedIn()
        && request.auth.uid == userId
        && (
          !resource.data.keys().hasAny(["usernameLower"])
          || !existsAfter(
            /databases/$(database)/documents/usernames/$(resource.data.usernameLower)
          )
        );
    }

    match /usernames/{username} {
      // Username login performs one exact document lookup. Collection listing
      // remains restricted to signed-in community discovery.
      allow get: if true;
      allow list: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "uid", "username", "loginEmail", "createdAt"
        ])
        && username.matches("^[a-z0-9_]{3,20}$")
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly([
          "uid", "username", "loginEmail", "createdAt"
        ])
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() >= 40
        && request.resource.data.body.size() <= 6000
        && validPostShape()
        && validPostMedia()
        && validPostTheme()
        && validPostAnalysis();
      allow update: if signedIn()
        && resource.data.authorId == request.auth.uid
        && request.resource.data.authorId == resource.data.authorId
        && request.resource.data.createdAt == resource.data.createdAt
        && validPostShape()
        && validPostMedia()
        && validPostTheme()
        && validPostAnalysis();
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "postId", "userId", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.createdAt is timestamp
        && likeId == request.resource.data.postId + "_" + request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (
          exists(
            /databases/$(database)/documents/posts/$(resource.data.postId)
          )
          && get(
            /databases/$(database)/documents/posts/$(resource.data.postId)
          ).data.authorId == request.auth.uid
        )
      );
      allow update: if false;
    }

    match /comments/{commentId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "postId", "authorId", "authorName", "authorPhoto", "text", "createdAt"
        ])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() >= 2
        && request.resource.data.authorName.size() <= 50
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt is timestamp
        && (!request.resource.data.keys().hasAny(["authorPhoto"])
          || (request.resource.data.authorPhoto is string
            && request.resource.data.authorPhoto.size() <= 180000))
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        );
      allow delete: if signedIn() && (
        resource.data.authorId == request.auth.uid
        || (
          exists(/databases/$(database)/documents/posts/$(resource.data.postId))
          && get(
            /databases/$(database)/documents/posts/$(resource.data.postId)
          ).data.authorId == request.auth.uid
        )
      );
      allow update: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (
          exists(/databases/$(database)/documents/posts/$(resource.data.postId))
          && get(
            /databases/$(database)/documents/posts/$(resource.data.postId)
          ).data.authorId == request.auth.uid
        )
      );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "postId", "userId", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.createdAt is timestamp
        && bookmarkId == request.resource.data.postId + "_" + request.auth.uid
        && exists(
          /databases/$(database)/documents/posts/$(request.resource.data.postId)
        );
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (
          exists(/databases/$(database)/documents/posts/$(resource.data.postId))
          && get(
            /databases/$(database)/documents/posts/$(resource.data.postId)
          ).data.authorId == request.auth.uid
        )
      );
      allow update: if false;
    }

    match /follows/{followId} {
      allow read: if signedIn()
        && (
          resource.data.from == request.auth.uid ||
          resource.data.to == request.auth.uid
        );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "from", "to", "fromName", "toName", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to != request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.fromName is string
        && request.resource.data.fromName.size() >= 2
        && request.resource.data.fromName.size() <= 50
        && request.resource.data.toName is string
        && request.resource.data.toName.size() >= 2
        && request.resource.data.toName.size() <= 50
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updatedAt"
        ])
        && request.resource.data.from == resource.data.from
        && request.resource.data.to == resource.data.to
        && request.resource.data.status in ["pending", "accepted"]
        && (
          resource.data.from == request.auth.uid ||
          resource.data.to == request.auth.uid
        );
      allow delete: if signedIn()
        && (
          resource.data.from == request.auth.uid ||
          resource.data.to == request.auth.uid
        );
    }

    match /notificationReads/{userId}/items/{itemId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(["notificationId", "readAt"])
        && request.resource.data.notificationId == itemId
        && request.resource.data.notificationId is string
        && request.resource.data.notificationId.size() >= 4
        && request.resource.data.notificationId.size() <= 180
        && request.resource.data.readAt is timestamp;
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /roomHistory/{userId}/rooms/{roomId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && roomId.matches("^[A-HJ-NP-Z2-9]{6}$")
        && request.resource.data.keys().hasOnly([
          "roomId", "title", "role", "status", "hostName",
          "savedAt", "lastOpenedAt"
        ])
        && request.resource.data.roomId == roomId
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 80
        && request.resource.data.role in ["host", "participant"]
        && request.resource.data.status in ["open", "closed", "complete"]
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() >= 2
        && request.resource.data.hostName.size() <= 50
        && request.resource.data.savedAt is timestamp
        && request.resource.data.lastOpenedAt is timestamp;
      allow delete: if signedIn()
        && (request.auth.uid == userId || isRoomHost(roomId));
    }

    match /rooms/{roomId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && roomId.matches("^[A-HJ-NP-Z2-9]{6}$")
        && request.resource.data.keys().hasOnly([
          "code", "title", "hostId", "hostName",
          "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.code == roomId
        && request.resource.data.hostId == request.auth.uid
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() >= 2
        && request.resource.data.hostName.size() <= 50
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 80
        && request.resource.data.status == "open"
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if signedIn()
        && resource.data.hostId == request.auth.uid
        && (
          (
            resource.data.status == "open"
            && request.resource.data.status == "closed"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "closedAt", "updatedAt"
            ])
            && request.resource.data.closedAt is timestamp
            && request.resource.data.updatedAt is timestamp
          ) || (
            resource.data.status in ["open", "closed"]
            && request.resource.data.status == "complete"
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "status", "winnerId", "winnerName", "winnerScore",
              "judgedAt", "updatedAt"
            ])
            && request.resource.data.winnerId is string
            && request.resource.data.winnerName is string
            && request.resource.data.winnerName.size() >= 2
            && request.resource.data.winnerName.size() <= 50
            && request.resource.data.winnerScore is int
            && request.resource.data.winnerScore >= 1
            && request.resource.data.winnerScore <= 10
            && request.resource.data.judgedAt is timestamp
            && request.resource.data.updatedAt is timestamp
          )
        );
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;

      match /participants/{userId} {
        allow get: if signedIn() && (
          request.auth.uid == userId || isRoomHost(roomId) || isRoomMember(roomId)
        );
        allow list: if isRoomHost(roomId) || isRoomMember(roomId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && exists(/databases/$(database)/documents/rooms/$(roomId))
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status
            == "open"
          && request.resource.data.keys().hasOnly([
            "roomId", "userId", "displayName", "photoURL", "theme", "joinedAt"
          ])
          && request.resource.data.roomId == roomId
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.displayName is string
          && request.resource.data.displayName.size() >= 2
          && request.resource.data.displayName.size() <= 50
          && request.resource.data.photoURL is string
          && request.resource.data.photoURL.size() <= 180000
          && request.resource.data.theme in [
            "Creative Expression", "Culture & Heritage", "Technology for Good",
            "Life & Wellbeing", "Nature & Sustainability", "Student Innovation",
            "Social Impact"
          ]
          && request.resource.data.joinedAt is timestamp;
        allow update: if signedIn()
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status
            == "open"
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["theme"])
          && request.resource.data.theme in [
            "Creative Expression", "Culture & Heritage", "Technology for Good",
            "Life & Wellbeing", "Nature & Sustainability", "Student Innovation",
            "Social Impact"
          ];
        allow delete: if isRoomHost(roomId);
      }

      match /submissions/{userId} {
        allow read: if isRoomHost(roomId) || isRoomMember(roomId);
        allow create: if signedIn()
          && request.auth.uid == userId
          && isRoomMember(roomId)
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status
            == "open"
          && validRoomSubmission(roomId, userId);
        allow update: if signedIn()
          && request.auth.uid == userId
          && get(/databases/$(database)/documents/rooms/$(roomId)).data.status
            == "open"
          && request.resource.data.createdAt == resource.data.createdAt
          && validRoomSubmission(roomId, userId);
        allow delete: if isRoomHost(roomId);
      }
    }

    match /messages/{messageId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          "chatId", "senderId", "receiverId", "participants",
          "messageType", "text", "createdAt", "editedAt", "callRoom", "mediaURL"
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.receiverId != request.auth.uid
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.receiverId in request.resource.data.participants
        && request.resource.data.chatId is string
        && request.resource.data.chatId in [
          request.resource.data.senderId + "_" + request.resource.data.receiverId,
          request.resource.data.receiverId + "_" + request.resource.data.senderId
        ]
        && request.resource.data.messageType in [
          "text", "video_call", "audio_call", "photo", "video", "link"
        ]
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp
        && (
          !request.resource.data.keys().hasAny(["editedAt"])
          || request.resource.data.editedAt is timestamp
        )
        && (
          (
            request.resource.data.messageType == "text"
            && !request.resource.data.keys().hasAny(["callRoom", "mediaURL"])
          )
          || (
            request.resource.data.messageType in ["video_call", "audio_call"]
            && request.resource.data.callRoom is string
            && request.resource.data.callRoom.size() >= 20
            && request.resource.data.callRoom.size() <= 100
            && request.resource.data.callRoom.matches("^[A-Za-z0-9-]+$")
            && !request.resource.data.keys().hasAny(["mediaURL"])
          )
          || (
            request.resource.data.messageType == "photo"
            && request.resource.data.mediaURL is string
            && request.resource.data.mediaURL.size() <= 500000
            && request.resource.data.mediaURL.matches(
              "^data:image/(jpeg|png|webp);base64,.*"
            )
            && !request.resource.data.keys().hasAny(["callRoom"])
          )
          || (
            request.resource.data.messageType in ["video", "link"]
            && request.resource.data.mediaURL is string
            && request.resource.data.mediaURL.size() <= 1000
            && request.resource.data.mediaURL.matches("^https://.*")
            && !request.resource.data.keys().hasAny(["callRoom"])
          )
        )
        && isConnected(
          request.resource.data.senderId,
          request.resource.data.receiverId
        );
      allow update: if signedIn()
        && resource.data.senderId == request.auth.uid
        && resource.data.messageType == "text"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "text", "editedAt"
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 1000
        && request.resource.data.editedAt is timestamp;
      allow delete: if signedIn()
        && resource.data.senderId == request.auth.uid;
    }
  }
}
